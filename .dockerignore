# No mandamos node_modules ni builds al contexto (se generan en la imagen).
# OJO: NO ignoramos game/bin/ — el WASM de Vexel está gitignoreado pero SÍ tiene
# que ir al build (el web lo copia a web/public/game en el sync).
**/node_modules
.git
web/dist
server/dist
deploy
scratchpad
*.log
# El secreto NGE_CONNECTION se pasa al contenedor en RUNTIME (docker run -e /
# compose), NO se hornea en la imagen. El store de ratings va a un volumen.
**/.env
server/data
