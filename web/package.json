{
  "name": "ajedrez-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Shell web (chess.com-inspired) para el ajedrez 1v1",
  "scripts": {
    "sync-assets": "node scripts/sync-assets.mjs",
    "sync-game": "node scripts/sync-game.mjs",
    "sync": "npm run sync-assets && npm run sync-game",
    "dev": "npm run sync && vite",
    "build": "npm run sync && tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/qrcode": "^1.5.6",
    "typescript": "^5.6.2",
    "vite": "^8.1.4"
  },
  "dependencies": {
    "nostr-game-protocol": "github:soyezequiel/Nostr-Game-Protocol",
    "nostr-tools": "^2.23.9",
    "qrcode": "^1.5.4"
  }
}
