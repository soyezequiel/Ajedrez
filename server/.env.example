# Puerto del servidor de ajedrez (sirve el web + WebSocket en el mismo puerto)
PORT=8787

# Reloj por jugador en ms (5 min por defecto)
DEFAULT_CLOCK_MS=300000

# Gracia en ms para reconectarse antes de perder por abandono (60 s por defecto)
ABANDON_GRACE_MS=60000

# Store de ratings ELO (JSON en disco). Default: server/data/ratings.json.
# En Docker montá un volumen en esta ruta para que sobreviva a redeploys.
# RATINGS_PATH=/data/ratings.json

# --- Apuestas custodiadas NGE (opcional) ---
# URI de conexión del escrow (SECRETO de servidor). Sin esto, las apuestas quedan
# apagadas (caps.bets=false) y el resto del juego funciona igual. Se obtiene del
# panel /provider de Luna Negra o POST /api/provider/nge/credential.
# NGE_CONNECTION=nostr+nge://...
